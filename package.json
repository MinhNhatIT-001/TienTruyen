{
  "name": "tientruyen",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @tientruyen/web --filter @tientruyen/api dev",
    "build": "pnpm --filter @tientruyen/api build && pnpm --filter @tientruyen/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @tientruyen/api test",
    "db:generate": "pnpm --filter @tientruyen/api db:generate",
    "db:migrate": "pnpm --filter @tientruyen/api db:migrate",
    "db:seed": "pnpm --filter @tientruyen/api db:seed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "local": "node scripts/local.mjs",
    "test:payments": "node scripts/test-payments.mjs",
    "backup": "node scripts/backup.mjs",
    "test:vercel": "node scripts/check-vercel.mjs",
    "test:backup": "node --test scripts/backup-crypto.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "prettier": "3.9.9",
    "typescript": "~5.9.3"
  }
}
