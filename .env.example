NODE_ENV=development
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://tientruyen:change-local-password@localhost:55432/tientruyen
POSTGRES_PASSWORD=change-local-password
REDIS_PASSWORD=change-local-redis-password
REDIS_URL=redis://:change-local-redis-password@localhost:56379
MEILI_MASTER_KEY=change-local-search-key-32-characters
JWT_SECRET=replace-with-random-secret-at-least-32-characters
PAYMENT_WEBHOOK_SECRET=replace-with-random-payment-secret-32-characters
DEV_TOPUP_ENABLED=false
PORT=4000
SMTP_URL=
MAIL_FROM=Tiên Truyện <noreply@example.invalid>

# local: nạp thử; payos: thanh toán thật
PAYMENT_PROVIDER=local
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_GRAPH_VERSION=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Cloud avatars: connect a PUBLIC Vercel Blob store. Do not commit real tokens.
BLOB_READ_WRITE_TOKEN=
# Optional store ID for automatic Vercel OIDC authentication
BLOB_STORE_ID=
# Random secret >=32 characters, shared only with the scheduler
CRON_SECRET=
# API_SERVICE_URL is injected by Vercel binding; do not set it manually.
